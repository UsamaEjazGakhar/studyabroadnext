generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["transactionApi"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  isApproved   Boolean   @default(false)
  status            String    @default("Pending") // Pending, Active, Rejected
  profilePicture    String?   // optional path to uploaded picture
  roleId       Int
  role         Role      @relation(fields: [roleId], references: [id])

  student      Student?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Relations
  appointments    Appointment[]
  payments        Payment[]
  documents       Document[]
  notifications   Notification[]
  serviceRequests ServiceRequest[]
  testimonials    Testimonial[]
  adminActions    AuditLog[] @relation("AdminActions")
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique
  users User[]
}

model Student {
  id        Int       @id @default(autoincrement())
  userId    Int       @unique
  user      User      @relation(fields: [userId], references: [id])
  firstName String
  lastName  String
  phone     String?
  address   String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  applications  Application[]
  documents     Document[]
  notifications Notification[]
  visaCases     VisaCase[]
  appointments  Appointment[]
  testimonials  Testimonial[]
}

model Application {
  id            Int       @id @default(autoincrement())
  studentId     Int
  scholarshipId Int?
  statusId      Int
  appliedAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  student     Student           @relation(fields: [studentId], references: [id])
  scholarship Scholarship?      @relation(fields: [scholarshipId], references: [id])
  status      ApplicationStatus @relation(fields: [statusId], references: [id])
}

model ApplicationStatus {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  applications Application[]
}

model Scholarship {
  id                Int       @id @default(autoincrement())
  title             String
  description       String?
  deadline          DateTime?
  categoryId        Int
  universityId      Int
  countryId         Int
  benefits          String?
  eligibility       String?
  requiredDocuments String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  category     ScholarshipCategory @relation(fields: [categoryId], references: [id])
  university   University          @relation(fields: [universityId], references: [id])
  country      Country             @relation(fields: [countryId], references: [id])
  applications Application[]
}

model ScholarshipCategory {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  scholarships Scholarship[]
}

model University {
  id          Int       @id @default(autoincrement())
  name        String    @unique
  countryId   Int
  description String?
  ranking     Int?
  tuitionFees String?
  programs    String?
  intakeDates String?
  facilities  String?
  eligibility String?
  createdAt   DateTime  @default(now())
  website     String? // optional website field
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  country           Country            @relation(fields: [countryId], references: [id])
  scholarships      Scholarship[]
  phDPrograms       PhdProgram[]
  supervisors       Supervisor[]
  details           UniversityDetail[]
  scholarshipAlerts ScholarshipAlert[]
}

model Country {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  code      String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  universities      University[]
  scholarships      Scholarship[]
  phDPrograms       PhdProgram[]
  details           CountryDetail[]
  costBreakdowns    CostBreakdown[]
  scholarshipAlerts ScholarshipAlert[]
}

model CostBreakdown {
  id          Int      @id @default(autoincrement())
  countryId   Int
  title       String
  amount      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id])
}

model CountryDetail {
  id        Int      @id @default(autoincrement())
  countryId Int
  section   String
  content   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country Country @relation(fields: [countryId], references: [id])
}

model UniversityDetail {
  id           Int      @id @default(autoincrement())
  universityId Int
  section      String
  content      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  university University @relation(fields: [universityId], references: [id])
}

model Blog {
  id            Int       @id @default(autoincrement())
  title         String
  slug          String    @unique
  content       String    @db.Text
  excerpt       String?
  metaTitle     String?
  metaDesc      String?
  tags          String?
  featuredImage String?
  publishedAt   DateTime?
  categoryId    Int
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  category BlogCategory @relation(fields: [categoryId], references: [id])
}

model BlogCategory {
  id    Int    @id @default(autoincrement())
  name  String @unique
  blogs Blog[]
}

model ConsultationLead {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  phone     String
  program   String
  country   String
  education String
  message   String?
  createdAt DateTime @default(now())
}

model Lead {
  id        Int       @id @default(autoincrement())
  name      String
  email     String
  phone     String?
  source    String?
  statusId  Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  status LeadStatus @relation(fields: [statusId], references: [id])
}

model LeadStatus {
  id    Int    @id @default(autoincrement())
  name  String @unique
  leads Lead[]
}

model Appointment {
  id          Int       @id @default(autoincrement())
  userId      Int
  studentId   Int?
  scheduledAt DateTime
  purpose     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user    User     @relation(fields: [userId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])
}

model Payment {
  id           Int      @id @default(autoincrement())
  userId       Int
  month        DateTime // first day of the month for this payment
  amount       Decimal
  proofPath    String   // stored file path
  invoice      String?  // optional invoice number/description
  status       String   @default("Pending") // Pending, Approved, Rejected
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  adminId   Int
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])
  action    String   // e.g., APPROVE_REGISTRATION, REJECT_PAYMENT
  targetId  Int      // ID of the user or payment affected
  createdAt DateTime @default(now())
}

model Document {
  id         Int      @id @default(autoincrement())
  uploadedAt DateTime @default(now())
  deletedAt  DateTime?
  userId     Int?
  studentId  Int?
  user       User?    @relation(fields: [userId], references: [id])
  student    Student? @relation(fields: [studentId], references: [id])
}

model Testimonial {
  id         Int       @id @default(autoincrement())
  userId     Int?
  studentId  Int?
  content    String
  authorName String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  user    User?    @relation(fields: [userId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])
}

model SuccessStory {
  id         Int       @id @default(autoincrement())
  title      String
  content    String
  authorName String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  studentId Int?
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user    User?    @relation(fields: [userId], references: [id])
  student Student? @relation(fields: [studentId], references: [id])
}

model VisaCase {
  id        Int       @id @default(autoincrement())
  studentId Int
  status    String
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  student Student @relation(fields: [studentId], references: [id])
}

model ServiceRequest {
  id          Int       @id @default(autoincrement())
  userId      Int
  type        String // e.g., Admission Processing, Visa Assistance
  description String?
  status      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  user User @relation(fields: [userId], references: [id])
}

model EmailSubscriber {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  subscribedAt DateTime @default(now())
}

model Event {
  id          Int      @id @default(autoincrement())
  title       String
  type        String
  date        DateTime
  description String?
  link        String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Resource {
  id          Int      @id @default(autoincrement())
  title       String
  type        String
  fileUrl     String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PhdProgram {
  id             Int       @id @default(autoincrement())
  title          String
  description    String?
  countryId      Int
  universityId   Int
  researchAreaId Int
  supervisorId   Int?
  eligibility    String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  country      Country      @relation(fields: [countryId], references: [id])
  university   University   @relation(fields: [universityId], references: [id])
  researchArea ResearchArea @relation(fields: [researchAreaId], references: [id])
  supervisor   Supervisor?  @relation(fields: [supervisorId], references: [id])
}

model ResearchArea {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  phdPrograms PhdProgram[]
}

model Supervisor {
  id           Int          @id @default(autoincrement())
  name         String
  universityId Int
  profile      String?
  phdPrograms  PhdProgram[]

  university University @relation(fields: [universityId], references: [id])
}

model ScholarshipAlert {
  id           Int        @id @default(autoincrement())
  title        String
  region       String
  universityId Int
  university   University @relation(fields: [universityId], references: [id])
  countryId    Int
  country      Country    @relation(fields: [countryId], references: [id])
  amount       String?
  deadline     DateTime?
  link         String?
  description  String?
  isNotified   Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}
